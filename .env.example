# Absolute origin of the deployed site.
#
# Used for canonical URLs, OpenGraph URLs, sitemap.xml, robots.txt and the
# JSON-LD `url` field. Set it in the deployment environment (Vercel > Project
# Settings > Environment Variables).
#
# There is no default production value on purpose. If this is unset the build
# falls back to http://localhost:3000 and prints a warning, so the gap is
# visible rather than silently pointing at a domain nobody owns.
NEXT_PUBLIC_SITE_URL=https://example.com
