# Absolute origin of the deployed site.
#
# Used for canonical URLs, OpenGraph URLs, sitemap.xml, robots.txt and the
# JSON-LD `url` field. Set it in the deployment environment (Vercel > Project
# Settings > Environment Variables).
#
# Defaults to the verified production homepage below when unset. Change this
# value when moving to a custom domain; use an origin without a path or query.
NEXT_PUBLIC_SITE_URL=https://sleepguardian.vercel.app
